{
  "name": "@iriscan/sdk",
  "version": "0.1.0",
  "description": "Official Iris SDK: blockchain investigation from code. Analyze wallets and tokens, find insiders and launch kits, trace funds through mixers and exchanges.",
  "license": "MIT",
  "author": "Iris (iriscan.app)",
  "homepage": "https://iriscan.app/developers",
  "keywords": [
    "iris",
    "iriscan",
    "solana",
    "ethereum",
    "blockchain",
    "investigation",
    "rug",
    "memecoin",
    "insiders",
    "bundle",
    "proxima",
    "aml",
    "tracing",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "IRIS_LIVE=1 vitest run test/live.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
